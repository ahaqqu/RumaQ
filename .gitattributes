# Ensure shell scripts are checked out with the executable bit set.
*.sh text eol=lf
scripts/*.sh text eol=lf mode=755
scripts/**/*.sh text eol=lf mode=755
scripts/test/*.sh text eol=lf mode=755
scripts/deploy/*.js text eol=lf mode=755
scripts/ci/*.mjs text eol=lf mode=755

# Automation toolchain entrypoints and the stack library (#356) are executed
# directly inside the images.
automation/**/*.sh text eol=lf mode=755

# Skill scripts run directly.
.agents/skills/**/*.sh text eol=lf mode=755
