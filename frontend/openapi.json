{
  "openapi": "3.1.0",
  "info": {
    "title": "RumaQ API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getApiHealth",
        "description": "Public health check.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/email-status": {
      "get": {
        "operationId": "getApiAuthEmailStatus",
        "description": "Reports whether email/password auth is enabled.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "operationId": "getApiMe",
        "description": "Returns the current authenticated user.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string",
                          "nullable": true
                        },
                        "picture": {
                          "type": "string",
                          "nullable": true
                        },
                        "isAdmin": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/stock": {
      "get": {
        "operationId": "getApiStock",
        "description": "Current inventory for the active household.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "location",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "stock": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/stock/{id}": {
      "patch": {
        "operationId": "patchApiStockById",
        "description": "Updates a stock item.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "qty": {
                    "type": "number",
                    "minimum": 0
                  },
                  "unit": {
                    "type": "string"
                  },
                  "location_id": {
                    "type": "string"
                  },
                  "expiry_date": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found"
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ]
      }
    },
    "/api/home": {
      "get": {
        "operationId": "getApiHome",
        "description": "Home dashboard stats for the active household.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/settings": {
      "get": {
        "operationId": "getApiSettings",
        "description": "Returns the current authenticated user settings.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "patch": {
        "operationId": "patchApiSettings",
        "description": "Updates the current user settings.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "ai_provider": {
                    "type": "string",
                    "enum": ["opencode", "openai", "anthropic", "gemini", "ollama", "custom"]
                  },
                  "ai_key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "ai_base_url": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "ai_model": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "ai_thinking_level": {
                    "type": "string",
                    "enum": ["low", "medium", "high", ""]
                  },
                  "persona_user_role": {
                    "type": "string"
                  },
                  "persona_ai_role": {
                    "type": "string"
                  },
                  "persona_enabled": {
                    "type": "boolean"
                  },
                  "motion_preference": {
                    "type": "string",
                    "enum": ["none", "reduced", "standard"]
                  },
                  "language": {
                    "type": "string",
                    "enum": ["id", "en"]
                  },
                  "theme_hue": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/ai-key/test": {
      "post": {
        "operationId": "postApiAiKeyTest",
        "description": "Validates an AI provider API key.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["provider"],
                "properties": {
                  "provider": {
                    "type": "string",
                    "enum": ["opencode", "openai", "anthropic", "gemini", "ollama", "custom"]
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "base_url": {
                    "type": "string",
                    "maxLength": 500
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK - key is valid"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/ai/usage": {
      "get": {
        "operationId": "getApiAiUsage",
        "description": "Returns today AI usage for the current user.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/ai/chat": {
      "post": {
        "operationId": "postApiAiChat",
        "description": "Send a message to the household-scoped assistant and receive a reply.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["message"],
                "properties": {
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "history": {
                    "type": "array",
                    "maxItems": 10,
                    "items": {
                      "type": "object",
                      "required": ["role", "content"],
                      "properties": {
                        "role": {
                          "type": "string",
                          "enum": ["user", "assistant"]
                        },
                        "content": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4000
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reply"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          },
          "402": {
            "description": "AI key not configured"
          },
          "429": {
            "description": "AI usage limit exceeded"
          },
          "502": {
            "description": "AI provider error"
          }
        }
      }
    },
    "/api/purchases/scan": {
      "post": {
        "operationId": "postApiPurchasesScan",
        "description": "Upload a receipt image, scan with AI OCR, return parsed items.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Scan complete"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "402": {
            "description": "AI key not configured"
          },
          "429": {
            "description": "AI usage limit exceeded"
          }
        }
      }
    },
    "/api/purchases": {
      "post": {
        "operationId": "postApiPurchases",
        "description": "Create a purchase with items, updating stock and purchase history.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["date", "items"],
                "properties": {
                  "store_id": {
                    "type": "string"
                  },
                  "date": {
                    "type": "string",
                    "minLength": 1
                  },
                  "receipt_image_key": {
                    "type": "string"
                  },
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["name", "qty", "unit", "price"],
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "qty": {
                          "type": "number",
                          "minimum": 0
                        },
                        "unit": {
                          "type": "string"
                        },
                        "price": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "item_id": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Purchase created"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "get": {
        "operationId": "getApiPurchases",
        "description": "List purchase history for the active household with filters and pagination.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "store",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "group_by",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["month", "store"]
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/purchases/{id}/receipt": {
      "get": {
        "operationId": "getApiPurchasesByIdReceipt",
        "description": "Stream a receipt image from R2.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Image stream"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found"
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ]
      }
    },
    "/api/purchases/patterns": {
      "get": {
        "operationId": "getApiPurchasesPatterns",
        "description": "Return top purchase patterns for the active household (avg interval, avg qty).",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/purchases/{id}": {
      "get": {
        "operationId": "getApiPurchasesById",
        "description": "Return a single purchase with all its items.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found"
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ]
      }
    },
    "/api/locations": {
      "get": {
        "operationId": "getApiLocations",
        "description": "Lists locations for the active household.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "post": {
        "operationId": "postApiLocations",
        "description": "Creates a new location for the active household.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["label"],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/locations/{id}": {
      "delete": {
        "operationId": "deleteApiLocationsById",
        "description": "Deletes a location if not referenced by stock.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Conflict - location in use"
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ]
      }
    },
    "/api/items": {
      "get": {
        "operationId": "getApiItems",
        "description": "Lists items for the active household.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/stores": {
      "get": {
        "operationId": "getApiStores",
        "description": "Lists stores for the active household.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "post": {
        "operationId": "postApiStores",
        "description": "Creates a new store for the active household.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["label"],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/stores/{id}": {
      "delete": {
        "operationId": "deleteApiStoresById",
        "description": "Deletes a store if not referenced by purchases or plans.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Conflict - store in use"
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ]
      }
    },
    "/api/admin/price-runs": {
      "get": {
        "operationId": "getApiAdminPriceRuns",
        "description": "Recent scraper run reports (admin-only).",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Not an admin"
          }
        }
      }
    },
    "/api/admin/scrape/stores": {
      "get": {
        "operationId": "getApiAdminScrapeStores",
        "description": "Stores available for an on-demand scrape (admin-only).",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "stores": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Not an admin"
          }
        }
      }
    },
    "/api/admin/scrape": {
      "post": {
        "operationId": "postApiAdminScrape",
        "description": "Queue an on-demand scrape of the given stores (admin-only). 409 when a scrape is already pending or running — one run at a time.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["stores"],
                "properties": {
                  "stores": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": ["superindo", "lotte-mart", "astro"]
                    },
                    "minItems": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error (unknown store slug)"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Not an admin"
          },
          "409": {
            "description": "A scrape is already pending or running"
          }
        }
      }
    },
    "/api/admin/scrape/commands": {
      "get": {
        "operationId": "getApiAdminScrapeCommands",
        "description": "Recent scrape commands, newest first (admin-only).",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "commands": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "stores": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "status": {
                            "type": "string"
                          },
                          "createdBy": {
                            "type": "string"
                          },
                          "createdAt": {
                            "type": "string"
                          },
                          "pickedUpAt": {
                            "type": "string",
                            "nullable": true
                          },
                          "finishedAt": {
                            "type": "string",
                            "nullable": true
                          },
                          "exitCode": {
                            "type": "integer",
                            "nullable": true
                          },
                          "error": {
                            "type": "string",
                            "nullable": true
                          },
                          "logTruncated": {
                            "type": "boolean"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Not an admin"
          }
        }
      }
    },
    "/api/admin/scrape/commands/{id}/events": {
      "get": {
        "operationId": "getApiAdminScrapeCommandsByIdEvents",
        "description": "Incremental log events for a scrape command (admin-only). Omit afterSeq for the full log; poll with afterSeq=<last seen seq> while the run is pending/running.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "afterSeq",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "events": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "seq": {
                            "type": "integer"
                          },
                          "ts": {
                            "type": "string"
                          },
                          "level": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "truncated": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Not an admin"
          },
          "404": {
            "description": "Unknown command"
          }
        }
      }
    },
