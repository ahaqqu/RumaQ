FROM node:22-slim AS node-dist

FROM oven/bun:1.4.0-slim AS api

# cloudflare.config.ts (the Worker build config) can only be loaded by real
# Node.js >= 22.18 — the bun image's `node` is a Bun shim that the config
# loader rejects, and shadowing it breaks bun's lifecycle-script execution.
# Install the real binary under a distinct name and use it only for the
# Worker build step in the entrypoint.
COPY --from=node-dist /usr/local/bin/node /usr/local/bin/node-real

# curl is the compose healthcheck's probe (and the runner's readiness gate runs
# on the host, so nothing else is needed here).
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Layer 1: dependencies (cached until the lockfile/manifests change). This is
# the only dependency tree the harness ever uses — node_modules is deliberately
# never bind-mounted (host bun installs hardlink into bun's global cache; a
# container must not be able to mutate that tree, and mounting it would tie the
# image's deps to the host platform).
COPY bun.lock package.json ./
COPY frontend/package.json ./frontend/
COPY backend/package.json ./backend/
COPY contract/package.json ./contract/
RUN --mount=type=cache,target=/root/.bun \
  bun install --frozen-lockfile

# Layer 2: build configs (image inputs — the toolchain digest in
# automation/scripts/lib/stack.sh hashes every file copied below).
COPY vite.config.ts ./
COPY backend/vite.config.ts ./backend/
COPY backend/tsconfig.json ./backend/
COPY backend/cloudflare.config.ts ./backend/
COPY contract/tsconfig.json ./contract/

# The backend build packs frontend/dist as Worker static assets
# (backend/vite.config.ts publicDir); the API test harness serves the SPA via
# nginx instead, so an empty directory is sufficient.
RUN mkdir -p frontend/dist

# Layer 3: the container-start build. Source is NOT copied: backend/src,
# contract/src, backend/migrations and automation/tests are read-only bind
# mounts, so an edit is picked up by the next run with zero image work. The
# bundle is produced by entrypoint-api.sh (content-hash cached).
COPY automation/docker/build-cache.sh automation/docker/entrypoint-api.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/entrypoint-api.sh

EXPOSE 8787

ENV NODE_ENV=test
ENV TEST_MODE=true

ENTRYPOINT ["/usr/local/bin/entrypoint-api.sh"]
CMD ["node", "automation/tests/support/worker-server.mjs"]
