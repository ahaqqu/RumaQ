FROM node:22-slim AS node-dist

FROM oven/bun:1.4.0-slim AS api

# cloudflare.config.ts (the Worker build config) can only be loaded by real
# Node.js >= 22.18 — the bun image's `node` is a Bun shim that the config
# loader rejects, and shadowing it breaks bun's lifecycle-script execution.
# Install the real binary under a distinct name and use it only for the
# Worker build step below.
COPY --from=node-dist /usr/local/bin/node /usr/local/bin/node-real

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Layer 1: dependencies (cached until lockfiles change)
COPY bun.lock package.json ./
COPY frontend/package.json ./frontend/
COPY backend/package.json ./backend/
RUN --mount=type=cache,target=/root/.bun \
  bun install --frozen-lockfile

# Layer 2: stable configs (rarely change)
COPY vite.config.ts ./
COPY backend/vite.config.ts ./backend/
COPY backend/tsconfig.json ./backend/
COPY backend/cloudflare.config.ts ./backend/

# Layer 3: build source (changes most frequently). Keep migrations and test
# support files out of this layer so backend-only edits don't invalidate them.
COPY backend/src/ ./backend/src/
COPY backend/migrations/ ./backend/migrations/
# The backend build packs frontend/dist as Worker static assets; the API test
# harness serves the SPA via nginx instead, so an empty dist is sufficient.
# Run vp with Node (not bunx) so cloudflare.config.ts can load.
RUN mkdir -p frontend/dist && node-real node_modules/.bin/vp build backend

# Layer 4: test support files (change independently of backend source)
COPY automation/tests/ ./automation/tests/

EXPOSE 8787

ENV NODE_ENV=test
ENV TEST_MODE=true

CMD ["node", "automation/tests/support/worker-server.mjs"]
