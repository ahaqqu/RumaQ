FROM oven/bun:1.4.0-slim

WORKDIR /app

USER root

# Layer 1: dependencies (cached until lockfiles change)
COPY bun.lock package.json ./
COPY frontend/package.json ./frontend/
COPY backend/package.json ./backend/
COPY contract/package.json ./contract/
COPY scraper/package.json ./scraper/
COPY scraper/tsconfig.json ./scraper/
RUN --mount=type=cache,target=/root/.bun/install/cache \
  bun install --frozen-lockfile

# Install the Chromium build matching @playwright/test from package.json so the
# browser version can never drift from the driver. --with-deps pulls the OS
# libraries via apt, which removes the need for a version-pinned base image.
RUN bunx playwright install --with-deps chromium

# Layer 2: stable configs & migrations (rarely change). Workspace vite configs
# are copied because the root vp config resolves each project's own config.
COPY vite.config.ts ./
COPY frontend/vite.config.js ./frontend/
COPY backend/vite.config.ts ./backend/
COPY backend/tsconfig.json ./backend/
COPY backend/migrations/ ./backend/migrations/
COPY automation/playwright.config.js ./automation/playwright.config.js

# Layer 3: app source (changes moderately)
COPY backend/src/ ./backend/src/
COPY frontend/src/ ./frontend/src/
# The contract workspace is imported by the backend (@rumaq/contract) and has
# no build step — the source is the package.
COPY contract/src/ ./contract/src/
COPY contract/tsconfig.json ./contract/
# The root vp config declares a scraper vitest project, so the project root
# must exist for every vitest startup (even when only --project integration
# runs) — without it vitest aborts with "Root path does not exist".
COPY scraper/src/ ./scraper/src/
COPY scraper/test/ ./scraper/test/

# Layer 4: tests (changes most frequently)
COPY automation/tests/ ./automation/tests/

ENV TEST_BASE_URL=http://proxy:3000

# Pre-generate Playwright-BDD tests so the output is part of the image. This
# avoids regenerating them on every test run and makes `bunx playwright test`
# discover tests immediately.
RUN bunx bddgen test --config automation/playwright.config.js

CMD ["sh", "-c", "bunx vp test --project integration && bun x playwright test --config automation/playwright.config.js && sync"]
