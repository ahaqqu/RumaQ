FROM oven/bun:1.4.0-slim AS build

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Layer 1: dependencies (cached until lockfiles change)
COPY bun.lock package.json ./
COPY frontend/package.json ./frontend/
COPY backend/package.json ./backend/
RUN --mount=type=cache,target=/root/.bun \
  bun install --frozen-lockfile

# Layer 2: stable configs & templates (rarely change)
COPY vite.config.ts ./
COPY frontend/vite.config.js ./frontend/
COPY frontend/index.html ./frontend/index.html
COPY backend/vite.config.ts ./backend/
COPY backend/wrangler.test.toml ./backend/

# Layer 3: src (changes most frequently)
COPY frontend/src/ ./frontend/src/

RUN bunx vp build frontend

FROM nginx:alpine

COPY --from=build /app/frontend/dist /usr/share/nginx/html
COPY automation/docker/nginx.web.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
