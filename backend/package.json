{
  "name": "rumaq-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.local.toml",
    "build": "vp build",
    "preview": "vp preview",
    "deploy": "wrangler deploy --config wrangler.cloudflare.toml",
    "deploy:prod": "wrangler deploy --config wrangler.cloudflare.toml --env production",
    "db:create": "bun ../scripts/deploy/setup-db.js",
    "db:migrate": "wrangler d1 migrations apply rumaq"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.4.0",
    "hono": "^4.12.31",
    "hono-openapi": "^1.3.1",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@cloudflare/workers-types": "^5.20260708.1",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
