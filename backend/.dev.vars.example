# Local-only secrets for `wrangler dev`.
# Copy this file to backend/.dev.vars and fill in real values.
# backend/.dev.vars is gitignored and must never be committed.

# Google OAuth 2.0 credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Random 64-char hex secret for signing JWTs.
# Generate with: openssl rand -hex 32
WORKER_JWT_SECRET=change-me-to-a-random-64-char-hex-string

# Random 64-char hex secret used to derive the AES-GCM key for AI API keys.
# Generate with: openssl rand -hex 32
WORKER_ENCRYPTION_KEY=change-me-to-a-random-64-char-hex-string

# Bearer secret for the internal price ingest endpoint
# (POST /api/internal/ingest/prices, pushed by the rumaq-scraper VPS job).
# Generate with: openssl rand -hex 32. Optional: when unset the endpoint
# returns 503 and everything else keeps working.
HAQITA_INGEST_SECRET=change-me-to-a-random-64-char-hex-string

# Allow the local Vite dev server origin.
PAGES_ORIGIN=http://localhost:5173

# Enable email/password auth for local testing.
EMAIL_AUTH_ENABLED=true
