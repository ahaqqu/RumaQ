# /etc/rumaq-scraper/env — the scraper's whole configuration, read by the
# systemd units before dropping to the service user (so the file stays
# root:root 0600; apply.sh installs it once and never overwrites).
#
# Copy to /etc/rumaq-scraper/env and fill in the values.

# Gemini (OCR + embeddings + verifier). https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Ingest endpoint (the RumaQ Worker). No trailing slash.
RUMAQ_INGEST_URL=https://rumaq.ahaqqu.com/api/internal/ingest/prices
RUMAQ_INGEST_SECRET=

# Go-live switch (PR4): uncomment to make the nightly job POST for real.
# Until then the pipeline runs dry-run and the timer stays disabled.
# RUMAQ_PUBLISH=true

# Optional overrides — defaults are baked into the code:
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_VERIFIER_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# LOTTE_URL=https://www.lottemart.co.id/all-promo-mart
# Tier 3 (per-store proxy, only if the browser tier is still challenged):
# LOTTE_PROXY_URL=
# SUPERINDO_PROXY_URL=
