# scraper/env.example — the variables the scraper reads, for reference only.
#
# NOT authoritative, and nothing installs it. The live file is
# /etc/rumaq-scraper/env (root:root 0600) on the box: operator-owned bytes that
# no deploy rewrites. The host contract and the templates for both root-only
# env files live in ahaqqu/vps rumaq/env/ (scraper.env.example,
# render.env.example), and its applier refuses a missing or loose file.
#
# Use this copy to know which variables the app reads and to run the scraper
# locally. Never copy it over the live file — it holds no secrets and would
# erase the keys.

# Gemini (OCR + embeddings + verifier). https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Ingest endpoint (the RumaQ Worker). No trailing slash.
RUMAQ_INGEST_URL=https://rumaq.ahaqqu.com/api/internal/ingest/prices
RUMAQ_INGEST_SECRET=

# Go-live switch: uncomment to make the nightly job POST for real. The box's
# live file already carries RUMAQ_PUBLISH=true; this template stays inert.
# RUMAQ_PUBLISH=true

# Optional overrides — shipped defaults are pinned in scraper/src/config.ts
# (kept honest by scraper/test/config.test.ts). If you uncomment one, use a
# model id from Google's current list — a dead id 404s the run:
# GEMINI_MODEL=
# GEMINI_VERIFIER_MODEL=
# GEMINI_EMBEDDING_MODEL=
# LOTTE_URL=https://www.lottemart.co.id/all-promo-mart
# Tier 3 (per-store proxy, only if the browser tier is still challenged):
# LOTTE_PROXY_URL=
# SUPERINDO_PROXY_URL=
