{
  "name": "rumaq",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "type": "module",
  "scripts": {
    "dev": "concurrently \"VITE_API_BASE=http://localhost:8787 vp dev frontend\" \"vp dev backend\"",
    "build": "vp build frontend && vp build backend",
    "preview": "vp preview frontend",
    "test": "vp test --project frontend && vp test --project backend",
    "test:watch": "vp test --project frontend --watch",
    "test:api": "vp run test:api",
    "test:e2e": "vp run test:e2e",
    "test:docker": "./automation/scripts/test-local.sh",
    "smoke": "./automation/scripts/run-smoke-tests.sh",
    "docs:api": "./scripts/docs.sh",
    "db:setup": "bun scripts/deploy/setup-db.js",
    "style": "vp check --fix",
    "style:check": "vp check",
    "deploy": "./scripts/deploy.sh",
    "deploy:frontend": "./scripts/deploy.sh frontend",
    "deploy:dry-run": "./scripts/deploy.sh dry-run"
  },
  "dependencies": {
    "cf": "1.0.0-beta.21"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "cloudflare": "^7.3.0",
    "concurrently": "^10.0.6",
    "hono": "^4.13.13",
    "hono-openapi": "^1.5.0",
    "jest-cucumber": "^4.5.0",
    "miniflare": "^4.20260730.0",
    "playwright-bdd": "^9.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "vite": "^8.3.5",
    "vite-plus": "^1.4.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "shell-quote": "^1.11.0",
    "tinypool": "^2.1.2",
    "uuid": "^11.1.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "packageManager": "bun",
    "runtime": "bun"
  },
  "packageManager": "bun@1.4.0"
}
